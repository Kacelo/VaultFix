// FaultFx - Full Data Model
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 removed `url`/`directUrl` from this block — connection URLs for
// Migrate live in prisma.config.ts, and the runtime client gets its connection
// from the PrismaPg adapter in src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────

enum Role {
  CLIENT
  ELECTRICIAN
  ADMIN
}

enum FaultPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FaultStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum JobStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/**
 * A member's standing WITHIN an organisation. Deliberately separate from
 * `Role`, which is platform-wide: the same person can be a CLIENT on the
 * platform and an OWNER of their employer's account.
 */
enum OrgRole {
  OWNER   // members, buildings, and later billing and contracts
  MANAGER // sees everything the organisation reports; can act on it
  MEMBER  // reports faults, sees the organisation's faults
}

enum CertType {
  COC              // Certificate of Compliance
  WIREMAN_LICENSE
  NTA_VERIFIED
}

enum SubscriptionPlan {
  FREE
  CLIENT_PRO
  ELECTRICIAN_PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIALING
}

// ─── Models ───────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  role      Role     @default(CLIENT)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  electricianProfile ElectricianProfile?
  memberships        Membership[]
  faultReports       FaultReport[]       @relation("ReporterFaults")
  jobsAsClient       Job[]               @relation("ClientJobs")
  reviewsGiven       Review[]            @relation("ReviewsGiven")
  receipts           Receipt[]
  subscription       Subscription?

  @@map("users")
}

model ElectricianProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ntaUid         String? @unique
  ntaVerified    Boolean @default(false)
  wiremanLicense String? // licence number
  wiremanVerified Boolean @default(false)
  specialisation String?
  serviceArea    String?
  calloutFee     Float?
  bio            String?
  isAvailable    Boolean @default(true)
  averageRating  Float?
  totalReviews   Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  certificates Certificate[]
  jobsAssigned Job[]          @relation("ElectricianJobs")
  reviewsReceived Review[]    @relation("ReviewsReceived")

  @@map("electrician_profiles")
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  locations    Location[]
  faultReports FaultReport[]

  @@map("organisations")
}

/**
 * One human, many organisations — which is the whole point. Someone can report
 * a fault at work and book an electrician for their home from the same login;
 * the active context decides which, and it is re-read from this table on every
 * request rather than trusted from the client.
 */
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
  @@map("memberships")
}

model Location {
  id          String   @id @default(cuid())
  building    String
  room        String
  description String?
  qrUrl       String?  // URL embedded in the QR code
  createdAt   DateTime @default(now())

  // null = unowned, which is every building that exists today. A fault at an
  // owned building belongs to that organisation whoever reports it.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  faultReports FaultReport[]

  @@index([organisationId])
  @@map("locations")
}

model FaultReport {
  id          String        @id @default(cuid())
  ref         String        @unique @default(cuid()) // e.g. VF-XXXXXX
  description String
  priority    FaultPriority @default(MEDIUM)
  status      FaultStatus   @default(OPEN)
  locationId  String?
  location    Location?     @relation(fields: [locationId], references: [id])
  reporterId  String?
  reporter    User?         @relation("ReporterFaults", fields: [reporterId], references: [id])
  reporterName String?      // for anonymous reports
  // null = a personal fault. Set from the building's owner when it has one,
  // otherwise from the reporter's active context.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  photoUrls   String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // A fault may accumulate a history of jobs: cancelling one has to leave the
  // fault assignable again. "At most one ACTIVE job" is enforced in createJob.
  jobs Job[]

  @@index([organisationId])
  @@map("fault_reports")
}

model Job {
  id            String    @id @default(cuid())
  faultId       String
  fault         FaultReport @relation(fields: [faultId], references: [id])
  clientId      String
  client        User      @relation("ClientJobs", fields: [clientId], references: [id])
  electricianId String
  electrician   ElectricianProfile @relation("ElectricianJobs", fields: [electricianId], references: [id])
  status        JobStatus @default(PENDING)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  receipt Receipt?
  review  Review?

  @@index([faultId])
  @@map("jobs")
}

model Certificate {
  id             String    @id @default(cuid())
  ref            String    @unique
  type           CertType
  electricianId  String
  electrician    ElectricianProfile @relation(fields: [electricianId], references: [id])
  clientName     String?
  propertyAddress String?
  propertyType   String?
  workDescription String?
  inspectionDate DateTime?
  signatureDataUrl String? // base64 canvas signature
  pdfUrl         String?   // stored PDF URL (Supabase Storage)
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@map("certificates")
}

model Review {
  id            String   @id @default(cuid())
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id])
  reviewerId    String
  reviewer      User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  electricianId String
  electrician   ElectricianProfile @relation("ReviewsReceived", fields: [electricianId], references: [id])
  rating        Int      // 1–5
  comment       String?
  createdAt     DateTime @default(now())

  @@map("reviews")
}

model Receipt {
  id           String   @id @default(cuid())
  ref          String   @unique
  jobId        String   @unique
  job          Job      @relation(fields: [jobId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  lineItems    Json     // Array of { desc: string, amount: number }
  totalAmount  Float
  currency     String   @default("NAD")
  pdfUrl       String?
  signedByClient     Boolean @default(false)
  signedByElectrician Boolean @default(false)
  issuedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  @@map("receipts")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id])
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  renewsAt  DateTime?
  cancelledAt DateTime?
  externalId String?           // Payment provider ID (DPO Pay / Stripe)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("subscriptions")
}
