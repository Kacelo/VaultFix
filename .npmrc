# pnpm 10+ EXITS NON-ZERO when a dependency's build script is skipped, which
# fails the install outright on CI — this is what broke the Vercel deploy
# (ERR_PNPM_IGNORED_BUILDS for prisma, @prisma/engines, esbuild, sharp,
# unrs-resolver).
#
# None of those builds are needed here:
#   @prisma/engines  the schema uses provider = "prisma-client" with the
#                    PrismaPg driver adapter, so there is no engine binary
#   prisma           `prisma generate` works without its postinstall
#   esbuild          only tsx and vitest need it, neither runs in the build
#   sharp            optional next/image optimiser; Next falls back
#   unrs-resolver    ships a prebuilt binary
#
# So skipping them is correct; failing the install over it is not.
strict-dep-builds=false
